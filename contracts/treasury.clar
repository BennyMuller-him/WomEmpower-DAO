;; contracts/treasury.clar
;; WomEmpower Treasury: Secure, auditable, governance-controlled lending pool
;; Supports deposits, withdrawals, loan disbursements, repayments, and yield tracking

(define-constant ERR-NOT-AUTHORIZED u100)
(define-constant ERR-INSUFFICIENT-BALANCE u101)
(define-constant ERR-INVALID-AMOUNT u102)
(define-constant ERR-LOAN-NOT-AUTHORIZED u103)
(define-constant ERR-RECEIPT-NOT-AUTHORIZED u104)
(define-constant ERR-TREASURY-LOCKED u105)
(define-constant ERR-INVALID-PRINCIPAL u106)
(define-constant ERR-ZERO-ADDRESS u107)
(define-constant ERR-ALREADY-INITIALIZED u108)
(define-constant ERR-NOT-INITIALIZED u109)
(define-constant ERR-INVALID-YIELD-RATE u110)
(define-constant ERR-YIELD-CLAIM-FAILED u111)
(define-constant ERR-REENTRANCY u112)

(define-data-var treasury-balance uint u0)
(define-data-var total-deposited uint u0)
(define-data-var total-disbursed uint u0)
(define-data-var total-repaid uint u0)
(define-data-var yield-accrued uint u0)
(define-data-var last-yield-block uint u0)
(define-data-var yield-rate-basis-points uint u500) ;; 5.00% default
(define-data-var treasury-admin principal (as-contract tx-sender))
(define-data-var loan-issuance-contract (optional principal) none)
(define-data-var repayment-contract (optional principal) none)
(define-data-var initialized bool false)
(define-data-var locked bool false)

(define-map depositors principal { amount: uint, block: uint })
(define-map yield-claims principal { claimed: uint, last-block: uint })

(define-read-only (get-treasury-balance)
  (ok (var-get treasury-balance))
)

(define-read-only (get-total-deposited)
  (ok (var-get total-deposited))
)

(define-read-only (get-total-disbursed)
  (ok (var-get total-disbursed))
)

(define-read-only (get-total-repaid)
  (ok (var-get total-repaid))
)

(define-read-only (get-yield-accrued)
  (ok (var-get yield-accrued))
)

(define-read-only (get-yield-rate)
  (ok (var-get yield-rate-basis-points))
)

(define-read-only (get-depositor-info (user principal))
  (map-get? depositors user)
)

(define-read-only (get-yield-claim-info (user principal))
  (map-get? yield-claims user)
)

(define-read-only (is-loan-issuance-authorized)
  (ok (var-get loan-issuance-contract))
)

(define-read-only (is-repayment-authorized)
  (ok (var-get repayment-contract))
)

(define-read-only (is-admin (caller principal))
  (ok (is-eq caller (var-get treasury-admin)))
)

(define-read-only (is-locked)
  (ok (var-get locked))
)

(define-private (validate-initialized)
  (asserts! (var-get initialized) (err ERR-NOT-INITIALIZED))
)

(define-private (validate-not-locked)
  (asserts! (not (var-get locked)) (err ERR-TREASURY-LOCKED))
)

(define-private (validate-amount (amount uint))
  (asserts! (> amount u0) (err ERR-INVALID-AMOUNT))
)

(define-private (validate-principal-not-zero (addr principal))
  (asserts! (not (is-eq addr 'SP000000000000000000002Q6VF78)) (err ERR-ZERO-ADDRESS))
)

(define-public (initialize-treasury
    (admin principal)
    (loan-contract principal)
    (repayment-contract principal)
    (initial-yield-rate uint))
  (begin
    (asserts! (not (var-get initialized)) (err ERR-ALREADY-INITIALIZED))
    (try! (validate-principal-not-zero admin))
    (try! (validate-principal-not-zero loan-contract))
    (try! (validate-principal-not-zero repayment-contract))
    (asserts! (and (>= initial-yield-rate u100) (<= initial-yield-rate u2000)) (err ERR-INVALID-YIELD-RATE))
    (var-set treasury-admin admin)
    (var-set loan-issuance-contract (some loan-contract))
    (var-set repayment-contract (some repayment-contract))
    (var-set yield-rate-basis-points initial-yield-rate)
    (var-set last-yield-block block-height)
    (var-set initialized true)
    (ok true)
  )
)

(define-public (deposit (amount uint))
  (let ((user tx-sender)
        (current-balance (var-get treasury-balance))
        (current-total (var-get total-deposited)))
    (try! (validate-initialized))
    (try! (validate-not-locked))
    (try! (validate-amount amount))
    (try! (as-contract (stx-transfer? amount user (as-contract tx-sender))))
    (var-set treasury-balance (+ current-balance amount))
    (var-set total-deposited (+ current-total amount))
    (match (map-get? depositors user)
      depositor
        (map-set depositors user {
          amount: (+ (get amount depositor) amount),
          block: block-height
        })
      (map-set depositors user {
        amount: amount,
        block: block-height
      })
    )
    (print { event: "deposit", user: user, amount: amount, block: block-height })
    (ok true)
  )
)

(define-public (withdraw (amount uint))
  (let ((user tx-sender)
        (current-balance (var-get treasury-balance))
        (depositor (unwrap! (map-get? depositors user) (err ERR-INSUFFICIENT-BALANCE))))
    (try! (validate-initialized))
    (try! (validate-not-locked))
    (try! (validate-amount amount))
    (asserts! (>= (get amount depositor) amount) (err ERR-INSUFFICIENT-BALANCE))
    (asserts! (>= current-balance amount) (err ERR-INSUFFICIENT-BALANCE))
    (var-set treasury-balance (- current-balance amount))
    (map-set depositors user {
      amount: (- (get amount depositor) amount),
      block: block-height
    })
    (try! (as-contract (stx-transfer? amount (as-contract tx-sender) user)))
    (print { event: "withdraw", user: user, amount: amount, block: block-height })
    (ok true)
  )
)

(define-public (disburse-loan (to principal) (amount uint))
  (let ((caller tx-sender)
        (current-balance (var-get treasury-balance))
        (authorized-contract (var-get loan-issuance-contract)))
    (try! (validate-initialized))
    (asserts! (is-some authorized-contract) (err ERR-LOAN-NOT-AUTHORIZED))
    (asserts! (is-eq (some caller) authorized-contract) (err ERR-NOT-AUTHORIZED))
    (try! (validate-amount amount))
    (asserts! (>= current-balance amount) (err ERR-INSUFFICIENT-BALANCE))
    (var-set treasury-balance (- current-balance amount))
    (var-set total-disbursed (+ (var-get total-disbursed) amount))
    (try! (as-contract (stx-transfer? amount (as-contract tx-sender) to)))
    (print { event: "loan-disbursed", to: to, amount: amount, block: block-height })
    (ok true)
  )
)

(define-public (receive-repayment (from principal) (amount uint) (interest uint))
  (let ((caller tx-sender)
        (authorized-contract (var-get repayment-contract))
        (new-balance (+ (var-get treasury-balance) amount interest))
        (new-repaid (+ (var-get total-repaid) amount))
        (new-yield (+ (var-get yield-accrued) interest)))
    (try! (validate-initialized))
    (asserts! (is-some authorized-contract) (err ERR-RECEIPT-NOT-AUTHORIZED))
    (asserts! (is-eq (some caller) authorized-contract) (err ERR-NOT-AUTHORIZED))
    (try! (validate-amount amount))
    (try! (as-contract (stx-transfer? amount from (as-contract tx-sender))))
    (try! (as-contract (stx-transfer? interest from (as-contract tx-sender))))
    (var-set treasury-balance new-balance)
    (var-set total-repaid new-repaid)
    (var-set yield-accrued new-yield)
    (print { event: "repayment-received", from: from, principal: amount, interest: interest, block: block-height })
    (ok true)
  )
)

(define-public (accrue-yield)
  (let ((current-block block-height)
        (last-block (var-get last-yield-block))
        (balance (var-get treasury-balance))
        (rate (var-get yield-rate-basis-points)))
    (try! (validate-initialized))
    (if (> current-block last-block)
      (let ((blocks-passed (- current-block last-block))
            (yield (/ (* (* balance rate) blocks-passed) (* u10000 u525600))))
        (var-set yield-accrued (+ (var-get yield-accrued) yield))
        (var-set last-yield-block current-block)
        (print { event: "yield-accrued", amount: yield, blocks: blocks-passed })
        (ok yield)
      )
      (ok u0)
    )
  )
)

(define-public (claim-yield)
  (let ((user tx-sender)
        (claim-info (default-to { claimed: u0, last-block: u0 } (map-get? yield-claims user)))
        (last-claim (get last-block claim-info))
        (current-block block-height))
    (try! (validate-initialized))
    (try! (accrue-yield))
    (let ((new-yield (calculate-user-yield user last-claim current-block)))
      (if (> new-yield u0)
        (let ((total-claimed (+ (get claimed claim-info) new-yield)))
          (map-set yield-claims user {
            claimed: total-claimed,
            last-block: current-block
          })
          (try! (as-contract (stx-transfer? new-yield (as-contract tx-sender) user)))
          (print { event: "yield-claimed", user: user, amount: new-yield })
          (ok new-yield)
        )
        (ok u0)
      )
    )
  )
)

(define-private (calculate-user-yield (user principal) (from-block uint) (to-block uint))
  (let ((balance-info (map-get? depositors user)))
    (match balance-info
      info
        (let ((user-balance (get amount info))
              (blocks (/ (+ (- to-block from-block) u1) u1))
              (total-yield (var-get yield-accrued))
              (total-supply (var-get treasury-balance)))
          (if (and (> user-balance u0) (> total-supply u0))
            (/ (* user-balance total-yield) total-supply)
            u0
          )
        )
      u0
    )
  )
)

(define-public (set-yield-rate (new-rate uint))
  (begin
    (try! (validate-initialized))
    (asserts! (is-eq tx-sender (var-get treasury-admin)) (err ERR-NOT-AUTHORIZED))
    (asserts! (and (>= new-rate u100) (<= new-rate u2000)) (err ERR-INVALID-YIELD-RATE))
    (try! (accrue-yield))
    (var-set yield-rate-basis-points new-rate)
    (print { event: "yield-rate-updated", rate: new-rate })
    (ok true)
  )
)

(define-public (lock-treasury)
  (begin
    (try! (validate-initialized))
    (asserts! (is-eq tx-sender (var-get treasury-admin)) (err ERR-NOT-AUTHORIZED))
    (var-set locked true)
    (print { event: "treasury-locked" })
    (ok true)
  )
)

(define-public (unlock-treasury)
  (begin
    (try! (validate-initialized))
    (asserts! (is-eq tx-sender (var-get treasury-admin)) (err ERR-NOT-AUTHORIZED))
    (var-set locked false)
    (print { event: "treasury-unlocked" })
    (ok true)
  )
)

(define-public (transfer-admin (new-admin principal))
  (begin
    (try! (validate-initialized))
    (asserts! (is-eq tx-sender (var-get treasury-admin)) (err ERR-NOT-AUTHORIZED))
    (try! (validate-principal-not-zero new-admin))
    (var-set treasury-admin new-admin)
    (print { event: "admin-transferred", new-admin: new-admin })
    (ok true)
  )
)